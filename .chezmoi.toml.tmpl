{{- $name := promptStringOnce . "name" "Git Name" -}}
{{- $email := promptStringOnce . "email" "Git commit email" -}}
{{- $nvimRepo := promptStringOnce . "nvimRepo" "Neovim repo SSH URL" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    nvimRepo = {{ $nvimRepo | quote }}
